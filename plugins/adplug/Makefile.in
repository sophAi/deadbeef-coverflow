adplug.la: $(adplug_la_OBJECTS) $(adplug_la_DEPENDENCIES) $(EXTRA_adplug_la_DEPENDENCIES) 
	$(AM_V_CXXLD)$(adplug_la_LINK) $(am_adplug_la_rpath) $(adplug_la_OBJECTS) $(adplug_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f adplug/*.$(OBJEXT)
	-rm -f adplug/*.lo
	-rm -f libbinio/*.$(OBJEXT)
	-rm -f libbinio/*.lo

distclean-compile:
	-rm -f *.tab.c

.c.o:
	$(AM_V_CC)$(COMPILE) -c -o $@ $<

.c.obj:
	$(AM_V_CC)$(COMPILE) -c -o $@ `$(CYGPATH_W) '$<'`

.c.lo:
	$(AM_V_CC)$(LTCOMPILE) -c -o $@ $<

adplug_la-plugin.lo: plugin.c
	$(AM_V_CC)$(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=compile $(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(adplug_la_CFLAGS) $(CFLAGS) -c -o adplug_la-plugin.lo `test -f 'plugin.c' || echo '$(srcdir)/'`plugin.c

